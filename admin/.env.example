# Copy to .env.local and adjust.

# true (default) → in-memory MockApi + FakeAuth. Set to false to hit the real backend.
VITE_USE_MOCKS=true

# Backend origin (only used when VITE_USE_MOCKS=false).
VITE_API_BASE_URL=http://localhost:8000

# Firebase web config (project the-crane-c6b86) — same project as the
# customer web app. Only used when VITE_USE_MOCKS=false. Server-side
# role=admin enforcement happens on every backend request regardless
# (ADM-2 AC) — this client only gates the UI.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=the-crane-c6b86.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=the-crane-c6b86
VITE_FIREBASE_STORAGE_BUCKET=the-crane-c6b86.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=765176672838
VITE_FIREBASE_APP_ID=
