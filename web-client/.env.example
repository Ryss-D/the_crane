# Copy to .env.local and adjust.

# true (default) → in-memory MockApi + FakeAuth. Set to false to hit the real backend.
VITE_USE_MOCKS=true

# Backend origin (only used when VITE_USE_MOCKS=false).
VITE_API_BASE_URL=http://localhost:8000

# TODO(FND-1): Firebase web config (apiKey, authDomain, projectId, ...) once the
# Firebase project exists. FakeAuth is used until then.
# TODO(FND-6): VITE_GOOGLE_MAPS_API_KEY (web-restricted) once the Maps key exists.
