<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>The Crane</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>the_crane</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- FND-6: empty until the iOS Maps key exists (deferred -- Android and
	     Web are wired, iOS isn't yet). AppDelegate.swift reads this via
	     Bundle.main and calls GMSServices.provideAPIKey with it; an empty
	     string there is a no-op (google_maps_flutter_ios just won't render
	     tiles on iOS until this is filled in), not a crash. TODO(FND-6):
	     paste the real key here once it's created. -->
	<key>GMSApiKey</key>
	<string></string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>La Grúa usa tu ubicación para guiarte hacia el cliente y compartir tu posición durante un servicio activo.</string>
	<!-- TRK-5 (this pass): plist-only prep for true background/locked-screen
	     tracking, checked against geolocator's own README (in its pub-cache
	     copy, ~/.pub-cache/hosted/pub.dev/geolocator-14.0.3/README.md) for
	     the exact keys it expects rather than guessing. NSLocationAlways-
	     AndWhenInUseUsageDescription is the string iOS shows on the
	     "Always" authorization prompt; UIBackgroundModes' "location" entry
	     is what geolocator's README says iOS 16+ additionally requires to
	     deliver fixes in the background. Neither of these makes the app
	     request "Always" at runtime by itself: Geolocator.requestPermission
	     (lib/core/location/location_source.dart) still only drives the
	     when-in-use flow today; wiring the "Always" runtime request is a
	     separate change. NOT verified on a real device: locked-screen
	     behavior needs one; see the TRK-5 doc note. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>La Grúa usa tu ubicación en segundo plano para seguir compartiendo tu posición mientras la pantalla está bloqueada durante un servicio activo.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<!-- TRK-3: lets iOS wake the app to run
		     `firebaseMessagingBackgroundHandler`
		     (lib/core/notifications/push_notifications.dart) for a data-only
		     FCM push while backgrounded (needs `content-available: 1` in the
		     APNs payload, which is the backend's job once it sends real
		     pushes -- checked `backend/app/services/push.py`/`realtime.py`
		     directly; not landed as of this pass). NOT verified on a real
		     device, and this mode does NOT cover a fully killed/terminated
		     app: Apple does not wake a terminated app for a silent
		     (data-only, no `alert`) push at all -- only a visible
		     `notification`-block push does that, and only via the OS's own
		     notification center, with no app code involved. See the TRK-3
		     doc note in docs/tasks/05-realtime-tracking.md. -->
		<string>remote-notification</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>FlutterSceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
