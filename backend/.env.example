# Copy to .env for local (non-docker) development. docker-compose.yml sets its own values.
DATABASE_URL=postgresql+asyncpg://crane:crane@localhost:5432/crane
REDIS_URL=redis://localhost:6379/0
# Path to the Firebase service-account JSON (FND-1). Leave unset until it exists —
# the app boots without it; only token verification requires it.
FIREBASE_CREDENTIALS_PATH=
ENV=dev
# WEB-1: browser origins allowed to call this API (web-client/admin dev servers by
# default -- add real domains once deployed).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# JOB-4 (pricing) + FND-6 follow-up (/v1/places/*, /v1/directions/route): a
# *server-side* Google Maps key, distinct from the app's Android/iOS/Web client
# keys -- restricted to Directions API + Places API, ideally IP-restricted once
# real hosting exists (OPS-3, not yet). Leave unset for local dev: pricing falls
# back to a haversine distance estimate, and the places/directions proxy
# endpoints degrade gracefully (empty autocomplete, 503 for details/route).
GOOGLE_MAPS_API_KEY=
# PAY-1..5: Wompi (Bancolombia) payments — a 5th external secret set, distinct
# from the 4 Google Maps keys above. WOMPI_PRIVATE_KEY authenticates
# transaction-creation/status/void calls; WOMPI_PUBLIC_KEY is only used to
# fetch the merchant acceptance token (never sent to a customer's browser
# from this backend); WOMPI_EVENTS_KEY verifies inbound webhook signatures
# (POST /v1/webhooks/wompi) — see app/services/payments/wompi.py's
# verify_event_signature. Leave all unset for local dev: every Wompi call
# raises WompiNotConfiguredError, mapped to a 503 by the API layer, same
# graceful-degradation discipline as GOOGLE_MAPS_API_KEY above. No real
# sandbox account exists yet as of this pass.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_KEY=
WOMPI_ENV=sandbox
